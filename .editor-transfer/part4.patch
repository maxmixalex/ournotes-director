diff --git a/src/OurNotes.Director.WinUI/NativeViewport.Gpu.cs b/src/OurNotes.Director.WinUI/NativeViewport.Gpu.cs
new file mode 100644
index 0000000..5b35fe2
--- /dev/null
+++ b/src/OurNotes.Director.WinUI/NativeViewport.Gpu.cs
@@ -0,0 +1,91 @@
+using Microsoft.UI.Xaml;
+using Microsoft.UI.Xaml.Controls;
+using Microsoft.UI.Xaml.Media;
+using OurNotes.Director.Core;
+using System.Runtime.InteropServices;
+
+namespace OurNotes.Director.WinUI;
+
+public sealed partial class NativeViewport
+{
+    readonly SwapChainPanel gpuPanel = new()
+    {
+        Visibility = Visibility.Collapsed, HorizontalAlignment = HorizontalAlignment.Left,
+        VerticalAlignment = VerticalAlignment.Top, IsHitTestVisible = false
+    };
+    GpuPreviewSurface? attachedGpu;
+    string? displayFailure;
+    Windows.Foundation.Rect lastGpuRect;
+    GpuPreviewSurface? scaledGpu;
+    void InitializeGpuPresentation()
+    {
+        surface.Children.Insert(surface.Children.IndexOf(overlay), gpuPanel);
+        gpuPanel.CompositionScaleChanged += (_, _) => LayoutCanvas();
+    }
+    bool PresentGpu(PreviewFrame frame)
+    {
+        var gpu = frame.GpuSurface!;
+        try
+        {
+            if (!ReferenceEquals(attachedGpu, gpu))
+            {
+                nint swap = gpu.AcquireSwapChain(); if (swap == 0) return false; // Newer frame already queued after a seek.
+                try
+                {
+                    var panel = ((WinRT.IWinRTObject)gpuPanel).NativeObject;
+                    Marshal.ThrowExceptionForHR(GpuPreviewSurface.AttachPanel(panel.ThisPtr, swap));
+                    GC.KeepAlive(gpuPanel);
+                }
+                finally { GpuPreviewSurface.ReleaseSwapChain(swap); }
+                attachedGpu = gpu;
+            }
+            image.Visibility = Visibility.Collapsed; gpuPanel.Visibility = Visibility.Visible;
+            checker.Visibility = Visibility.Collapsed; displayFailure = null;
+            return true;
+        }
+        catch (Exception error) when (error is COMException or InvalidCastException or DllNotFoundException or EntryPointNotFoundException)
+        {
+            displayFailure = "GPU 画布绑定失败，已请求兼容显示：" + error.Message;
+            _ = DisableGpuAsync(frame.SessionId, displayFailure); return false;
+        }
+    }
+    async Task DisableGpuAsync(long expectedSession, string reason)
+    { try { await session.DisableGpuPresentationAsync(reason, expectedSession); } catch (Exception error) { PresentFailure(error); } }
+    void DetachGpu()
+    {
+        if (attachedGpu is not null)
+        {
+            var panel = ((WinRT.IWinRTObject)gpuPanel).NativeObject;
+            Marshal.ThrowExceptionForHR(GpuPreviewSurface.AttachPanel(panel.ThisPtr, 0));
+            attachedGpu = null;
+        }
+        gpuPanel.Visibility = Visibility.Collapsed; image.Visibility = checker.Visibility = Visibility.Visible;
+    }
+    void LayoutGpu(Windows.Foundation.Rect rect)
+    {
+        if (gpuPanel.Visibility != Visibility.Visible) return;
+        if (lastGpuRect == rect && ReferenceEquals(scaledGpu, attachedGpu)) return;
+        gpuPanel.Width = rect.Width; gpuPanel.Height = rect.Height;
+        try { attachedGpu?.SetDisplaySize(rect.Width, rect.Height); }
+        catch (COMException error) { if (LastFrame is { } frame) _ = DisableGpuAsync(frame.SessionId, "GPU 画布缩放失败：" + error.Message); return; }
+        gpuPanel.RenderTransform = new TranslateTransform { X = rect.X, Y = rect.Y };
+        lastGpuRect = rect; scaledGpu = attachedGpu;
+    }
+    internal void RunGpuCompositionSmoke(Action<bool, string> check)
+    {
+        using var test = GpuPreviewSurface.CreateCompositionTest(64, 64);
+        uint rgba = test.ReadCompositionTestPixel();
+        test.SetDisplaySize(128, 96);
+        check((rgba >> 24) == 255 && ((rgba >> 8) & 255) is >= 127 and <= 128 && ((rgba >> 16) & 255) is >= 191 and <= 192,
+            "独立 WARP 检查：D3D11 交换链生成真实像素，不冒充硬件互操作验证");
+        nint borrowed = test.AcquireSwapChain();
+        try
+        {
+            var panel = ((WinRT.IWinRTObject)gpuPanel).NativeObject;
+            check(borrowed != 0 && GpuPreviewSurface.AttachPanel(panel.ThisPtr, borrowed) >= 0,
+                "原生 WinUI SwapChainPanel 接受独立 COM 引用的交换链");
+            check(GpuPreviewSurface.AttachPanel(panel.ThisPtr, 0) >= 0, "交换链可在窗口线程解除绑定");
+        }
+        finally { GpuPreviewSurface.ReleaseSwapChain(borrowed); }
+    }
+}
diff --git a/src/OurNotes.Director.WinUI/NativeViewport.Navigation.cs b/src/OurNotes.Director.WinUI/NativeViewport.Navigation.cs
new file mode 100644
index 0000000..58effae
--- /dev/null
+++ b/src/OurNotes.Director.WinUI/NativeViewport.Navigation.cs
@@ -0,0 +1,74 @@
+using Microsoft.UI.Xaml;
+using Microsoft.UI.Xaml.Controls;
+using Microsoft.UI.Xaml.Input;
+using Windows.Foundation;
+using Windows.System;
+
+namespace OurNotes.Director.WinUI;
+
+public sealed partial class NativeViewport
+{
+    internal Func<MenuFlyout>? ContextMenuFactory { get; set; }
+    bool showingEmptyCanvas, panning;
+    int emptyWidth = 1920, emptyHeight = 1080;
+    double viewZoom = 1;
+    Point viewPan, panStart, panOrigin;
+    uint panPointer;
+
+    public void SetEmptyCanvas(int width, int height)
+    {
+        if (width < 16 || height < 16) throw new ArgumentOutOfRangeException(nameof(width));
+        showingEmptyCanvas = true; sourceVersion++; session.Pause(); HasCurrentSource = false; loading = false;
+        emptyWidth = width; emptyHeight = height;
+        lock (frameGate) { pendingFrame = null; Volatile.Write(ref lastFrame, null); }
+        DetachGpu(); image.Source = null; HideSelection(); status.Text = "空白画布 · 添加角色或素材开始创作";
+        FitCanvas();
+    }
+    public void FitCanvas() { viewZoom = 1; viewPan = default; LayoutCanvas(); }
+
+    void InitializeWorkspaceNavigation()
+    {
+        IsTabStop = true;
+        ToolTipService.SetToolTip(surface, "滚轮缩放画布 · 中键拖动平移 · Ctrl+滚轮缩放角色 · F 适应窗口 · 右键对象操作");
+        surface.ContextRequested += (_, args) =>
+        {
+            if (ContextMenuFactory is null) return;
+            var options = new Microsoft.UI.Xaml.Controls.Primitives.FlyoutShowOptions();
+            if (args.TryGetPosition(surface, out Point point))
+            {
+                options.Position = point;
+                if (InCanvas(point))
+                { var normalized = Normalize(point); SelectedTargetId = HitTest(normalized.X, normalized.Y)?.Id; }
+            }
+            ContextMenuFactory().ShowAt(surface, options); args.Handled = true;
+        };
+        surface.PointerPressed += (_, args) =>
+        {
+            var point = args.GetCurrentPoint(surface);
+            if (!point.Properties.IsMiddleButtonPressed) return;
+            panning = true; panPointer = args.Pointer.PointerId; panStart = point.Position; panOrigin = viewPan;
+            surface.CapturePointer(args.Pointer); args.Handled = true;
+        };
+        surface.PointerMoved += (_, args) =>
+        {
+            if (!panning || args.Pointer.PointerId != panPointer) return;
+            var point = args.GetCurrentPoint(surface).Position;
+            viewPan = new(panOrigin.X + point.X - panStart.X, panOrigin.Y + point.Y - panStart.Y);
+            LayoutCanvas(); args.Handled = true;
+        };
+        surface.PointerReleased += (_, args) =>
+        { if (panning && args.Pointer.PointerId == panPointer) { panning = false; surface.ReleasePointerCapture(args.Pointer); args.Handled = true; } };
+        surface.PointerCaptureLost += (_, _) => panning = false;
+        KeyDown += (_, args) => { if (args.Key == VirtualKey.F) { FitCanvas(); args.Handled = true; } };
+    }
+    void ZoomCanvas(Point anchor, int delta)
+    {
+        if (delta == 0 || imageRect.Width <= 0) return;
+        var coordinate = Normalize(anchor);
+        double next = Math.Clamp(viewZoom * Math.Pow(1.12, delta / 120d), .1, 12);
+        double ratio = next / viewZoom;
+        viewPan = new(anchor.X - surface.ActualWidth / 2 + (.5 - coordinate.X) * imageRect.Width * ratio,
+            anchor.Y - surface.ActualHeight / 2 + (.5 - coordinate.Y) * imageRect.Height * ratio);
+        viewZoom = next; LayoutCanvas();
+    }
+}
