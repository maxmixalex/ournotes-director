+API HRESULT __cdecl OurNotesGpuSetDisplaySize(Surface* s, float x, float y) noexcept {
+    if (!s || !s->swap || !s->shared || !s->back) return E_INVALIDARG;
+    HRESULT hr = OurNotesGpuScaleSwapChain(s->swap.Get(), x, y);
